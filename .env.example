DB_NAME=bookgram
DB_USER=bookgram
DB_PASSWORD=bookgram
DB_PORT=5432
API_PORT=8080

# Generate with: openssl rand -base64 32
# Must be the EXACT same value as JWT_SECRET in web/.env.local, or session
# verification will silently fail (token signed here, verified there).
JWT_SECRET=replace-with-openssl-rand-base64-32-output
